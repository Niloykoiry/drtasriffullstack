
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model AppointmentBooking {
  id              String            @id @default(cuid())
  name            String
  phone           String
  email           String?
  appointmentDate DateTime          @db.Date
  reason          String
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([appointmentDate, status])
  @@index([createdAt])
}

model SiteSection {
  id           String   @id @default(cuid())
  key          String   @unique
  content      Json
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("site_sections")
}

model SiteSettings {
  id        String   @id @default("default")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  content      Json
  imageUrl     String?
  imageAlt     Json?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("services")
}

model Achievement {
  id           String    @id @default(cuid())
  content      Json
  achievedAt   DateTime?
  imageUrl     String?
  imageAlt     Json?
  isPublished  Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, displayOrder])
  @@map("achievements")
}

model Publication {
  id           String    @id @default(cuid())
  content      Json
  publishedAt  DateTime?
  imageUrl     String?
  imageAlt     Json?
  isPublished  Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, displayOrder])
  @@map("publications")
}

model BlogCategory {
  id         String     @id @default(cuid())
  slug       String     @unique
  content    Json
  posts      BlogPost[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("blog_categories")
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  content         Json
  excerpt         Json
  body            Json
  seo             Json
  tags            String[]      @default([])
  status          ContentStatus @default(DRAFT)
  author          String
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImageId String?
  featuredImage   Media?        @relation("BlogFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

model FAQ {
  id           String   @id @default(cuid())
  content      Json
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("faqs")
}

model Testimonial {
  id           String   @id @default(cuid())
  content      Json
  imageUrl     String?
  imageAlt     Json?
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("testimonials")
}

model BeforeAfterCase {
  id            String   @id @default(cuid())
  content       Json
  beforeImageId String
  beforeImage   Media    @relation("BeforeAfterBefore", fields: [beforeImageId], references: [id], onDelete: Restrict)
  afterImageId  String
  afterImage    Media    @relation("BeforeAfterAfter", fields: [afterImageId], references: [id], onDelete: Restrict)
  isPublished   Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([beforeImageId])
  @@index([afterImageId])
  @@map("before_after_cases")
}

model GalleryItem {
  id           String   @id @default(cuid())
  content      Json
  imageId      String
  image        Media    @relation(fields: [imageId], references: [id], onDelete: Restrict)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([imageId])
  @@map("gallery_items")
}

model Media {
  id                String            @id @default(cuid())
  url               String
  publicId          String            @unique
  altText           Json
  fileName          String
  format            String
  width             Int?
  height            Int?
  bytes             Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  blogPosts         BlogPost[]        @relation("BlogFeaturedImage")
  beforeAfterBefore BeforeAfterCase[] @relation("BeforeAfterBefore")
  beforeAfterAfter  BeforeAfterCase[] @relation("BeforeAfterAfter")
  galleryItems      GalleryItem[]

  @@index([createdAt])
  @@map("media")
}
